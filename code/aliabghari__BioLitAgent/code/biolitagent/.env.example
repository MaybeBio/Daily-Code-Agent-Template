# ─────────────────────────────────────────────────────────────────────────────
# BioLitAgent — Environment Variable Template
# Copy this file to .env (which is git-ignored) and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ── NCBI / PubMed (used by literature_scout & pubmed MCP server) ─────────────

# Your registered e-mail address.
# Required by NCBI's Entrez fair-use policy for all E-utilities requests.
# Register / verify at: https://www.ncbi.nlm.nih.gov/account/
NCBI_EMAIL=your.email@example.com

# NCBI API key (free, from https://www.ncbi.nlm.nih.gov/account/settings/).
# Raises the E-utilities rate limit from 3 req/s to 10 req/s.
NCBI_API_KEY=your_ncbi_api_key_here


# ── bioRxiv / medRxiv (used by the biorxiv MCP server) ───────────────────────

# The public bioRxiv API (https://api.biorxiv.org/) requires no authentication.
# No credentials needed here — section reserved for future provider extensions.


# ── LLM Orchestration & Extraction (Google Gemini) ──────────────────────────

# Google AI / Gemini API key.
# Required for LLM-based technical synthesis, regulatory extraction, and PDF parsing.
# Obtain at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API key — reserved for future use if an alternate orchestrator is configured.
# OPENAI_API_KEY=


# ── Reviewer & Governance Controls ──────────────────────────────────────────

# Reviewer identity stamped into SQLite audit tables (knowledge_store.db)
# and report provenance footers. Defaults to system username if left blank.
BIOLITAGENT_REVIEWER=Senior_Bioprocess_Scientist

# Pre-flight quota confirmation bypass (0 = prompt interactively, 1 = auto-confirm).
# In production / CI or headless environments, set to 1 after verifying daily quota.
BIOLITAGENT_PREFLIGHT_CONFIRMED=0
